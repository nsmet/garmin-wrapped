{
  "name": "mini-track-record",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "dev:cloudflare": "node scripts/cloudflare.mjs dev",
    "build:cloudflare": "node scripts/cloudflare.mjs build",
    "check:cloudflare": "node scripts/cloudflare.mjs verify",
    "preview:cloudflare": "node scripts/cloudflare.mjs preview",
    "deploy:cloudflare:dry-run": "node scripts/cloudflare.mjs dry-run",
    "deploy:cloudflare": "node scripts/cloudflare.mjs deploy",
    "deploy:cloudflare:built": "node scripts/cloudflare.mjs deploy-built",
    "secret:cloudflare": "node scripts/cloudflare.mjs secret"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "type": "module"
}
