{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garmin-wrapped",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "garmin-wrapped.miniwatt.app", "custom_domain": true }
  ],
  "vars": {
    "AUTH_MODE": "visitor",
    "GARMIN_MODE": "personal",
    "PUBLIC_ORIGIN": "https://garmin-wrapped.miniwatt.app"
  },
  "assets": { "run_worker_first": ["/api/*"] },
  "ratelimits": [
    {
      "name": "CONNECT_RATE_LIMITER",
      "namespace_id": "73151001",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "DATA_RATE_LIMITER",
      "namespace_id": "73151002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
