# Cloudflare: npm run secret:cloudflare stores SESSION_SECRET securely.
# Non-secret Cloudflare settings live in wrangler.cloudflare.jsonc.
# For local development, copy this file to the ignored .dev.vars file.
GARMIN_MODE=personal
SESSION_SECRET=replace-with-at-least-32-random-bytes-base64url
# Legacy Sites deployment only. Cloudflare uses isolated visitor sessions.
PERSONAL_OWNER_ID=
