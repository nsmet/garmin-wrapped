{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/garmin-wrapped/chapter-output-v3.schema.json",
  "title": "Garmin Wrapped chapter-first story plan",
  "type": "object",
  "required": ["schemaVersion", "status", "period", "chapters", "omittedChapters"],
  "properties": {
    "schemaVersion": { "const": "3.0.0" },
    "status": { "enum": ["ok", "blocked"] },
    "period": {
      "type": "object", "required": ["year", "complete"],
      "properties": {"year": {"type": "integer"}, "complete": {"type": "boolean"}}
    },
    "athleteIdentity": {"type": "object"},
    "chapters": {"type": "array", "items": {"$ref": "#/$defs/chapter"}},
    "omittedChapters": {"type": "array", "items": {"type": "object", "required": ["chapterId", "reason"], "properties": {"chapterId": {"type": "string"}, "reason": {"type": "string"}}}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "privateTrace": {"type": "array", "items": {"type": "object"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "chapter": {
      "type": "object",
      "required": ["chapterId", "kind", "order", "title", "editorialQuestion", "stories"],
      "properties": {
        "chapterId": {"type": "string"}, "kind": {"type": "string"}, "sportKey": {"type": ["string", "null"]},
        "order": {"type": "integer", "minimum": 0}, "title": {"type": "string"},
        "editorialQuestion": {"type": "string"}, "thesis": {"type": ["string", "null"]},
        "depth": {"enum": ["deep", "compact", "spotlight", "core"]},
        "whyIncluded": {"type": "string"},
        "stories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/story"}}
      }
    },
    "story": {
      "type": "object", "required": ["storyId", "phase", "primaryClaim", "claimKey", "evidenceStatus", "sharePolicy"],
      "properties": {
        "storyId": {"type": "string"}, "definitionId": {"type": ["string", "null"]},
        "phase": {"enum": ["position", "scale", "pattern", "peak", "twist", "payoff"]},
        "kind": {"type": ["string", "null"]}, "primaryClaim": {"type": "string"},
        "supportingCopy": {"type": ["string", "null"]},
        "claimKey": {"type": "string"}, "evidenceStatus": {"enum": ["verified", "qualified"]},
        "verifiedFacts": {"type": "array", "items": {"type": "object"}},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}},
        "sharePolicy": {"enum": ["allow_sanitized", "private_only", "requires_explicit_share_consent"]},
        "whySelected": {"type": "string"}
      }
    }
  }
}
