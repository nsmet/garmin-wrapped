{
  "name": "miniwatt-wrapped",
  "description": "Private Garmin Personal API recap for iOS and Android, with bundled dot stories and native PNG sharing.",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/dom-webview": "~58.0.0",
    "@expo/metro-runtime": "~58.0.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "expo-doctor": "1.21.6",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:baseline": "node scripts/verify-baseline.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "test:viewer": "playwright test",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:context": "node scripts/prepare-context.mjs",
    "prepare:runtime-probe": "node scripts/prepare-context.mjs --runtime-probe",
    "check": "npm run verify:baseline && npm run verify:assets && npm run typecheck && npm test && npm run test:native && npm run check:boundary",
    "bundle:ios": "expo export --platform ios --output-dir .build/ios",
    "bundle:android": "expo export --platform android --output-dir .build/android",
    "doctor": "expo-doctor",
    "test:hermes": "node scripts/test-hermes.mjs",
    "test:native": "jest --runInBand",
    "test:hermes:portable": "node scripts/test-hermes.mjs --portable",
    "verify:assets": "node scripts/verify-assets.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0"
}
